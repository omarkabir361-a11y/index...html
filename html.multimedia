<!DOCTYPE html>
<html>
<head>
    <title>HTML Multimedia</title>
</head>
<body>

<h1>My Multimedia Page</h1>

<h2>Image</h2>
<img src="photo.jpg" alt="My photo" width="300">

<h2>Audio</h2>
<audio controls>
    <source src="music.mp3" type="audio/mpeg">
</audio>

<h2>Video</h2>
<video width="500" controls>
    <source src="video.mp4" type="video/mp4">
</video>

</body>
</html>